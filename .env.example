# Compose will automatically read `.env` from the project root.
# Copy this file to `.env` and adjust values as needed.

# ---- Image / Port ----
GROK2API_PORT=8000
# GROK2API_IMAGE=ghcr.io/tqzhr/grok2api:latest

# ---- Runtime ----
TZ=Asia/Shanghai
LOG_LEVEL=INFO
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1

# ---- Storage (default: local) ----
SERVER_STORAGE_TYPE=local
SERVER_STORAGE_URL=
STORAGE_WAIT_TIMEOUT=60
# Local data directory (config.toml / token.json / cache / stats / ...).
# Default: <project_root>/data. Absolute or relative (relative is anchored to project root).
# Docker users: if you change this, adjust the volume mount in docker-compose.yml accordingly.
# SERVER_DATA_DIR=

# ---- Optional profiles (uncomment to enable) ----
# COMPOSE_PROFILES=mysql

# ---- MySQL example ----
# COMPOSE_PROFILES=mysql
# SERVER_STORAGE_TYPE=mysql
# MYSQL_DB=grok2api
# MYSQL_USER=grok2api
# MYSQL_PASSWORD=change_me
# MYSQL_ROOT_PASSWORD=change_me
# SERVER_STORAGE_URL=mysql+aiomysql://grok2api:change_me@mysql:3306/grok2api

